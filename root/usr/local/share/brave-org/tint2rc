# Small, always-visible bottom taskbar for X11/Openbox; restore minimized Brave by clicking it.
# Stored in the image (not under /config), so existing browser profiles are not touched.

# Backgrounds
rounded = 0
border_width = 0
background_color = #202124 100
border_color = #202124 100

# Panel
panel_items = T
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 34
panel_margin = 0 0
panel_padding = 6 3 6
panel_background_id = 1
panel_dock = 0
panel_layer = top
strut_policy = follow_size
panel_pivot_struts = 0
wm_menu = 0

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 4 2 4
taskbar_background_id = 1
taskbar_active_background_id = 1
taskbar_name = 0
taskbar_name_padding = 0 0

# Task buttons
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 360 30
task_padding = 8 3 8
task_font = Sans 10
task_font_color = #FFFFFF 100
task_active_font_color = #FFFFFF 100
task_background_id = 1
task_active_background_id = 1
task_iconified_background_id = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

autohide = 0
